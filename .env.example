# Higgsfield Cloud API (https://cloud.higgsfield.ai/api-keys)
HIGGSFIELD_API_KEY=your_higgsfield_api_key
HIGGSFIELD_SECRET=your_higgsfield_secret

# Google Gemini API for Nano Banana 2 (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key

# Instagram Graph API / Meta (https://developers.facebook.com/)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# TikTok Content Posting API (https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Output directory for generated content
OUTPUT_DIR=./output
# Data directory for influencer profiles, content queue, etc.
DATA_DIR=./data

# Set to true to skip quality control review (not recommended)
AUTO_APPROVE=false
